
{
  "manifest_version": 3,
  "name": "Khan Academy Auto Login",
  "version": "1.0.0",
  "description": "Automatically signs in to Khan Academy using locally configured credentials.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://accounts.khanacademy.org/login*",
        "https://www.khanacademy.org/login*"
      ],
      "js": [
        "toast.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.khanacademy.org/*"
      ],
      "js": [
        "toast.js",
        "verify.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
