
{
  "manifest_version": 3,
  "name": "Khan Academy Auto Login",
  "version": "1.0.0",
  "description": "Automatically signs in to Khan Academy using locally configured credentials.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://accounts.khanacademy.org/*",
    "https://www.khanacademy.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://accounts.khanacademy.org/login*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
